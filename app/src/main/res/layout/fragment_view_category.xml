<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/appBackground"
    android:orientation="vertical"
    android:padding="@dimen/_10sdp"
    tools:context=".fragments.ViewCategoryFragment">

    <ImageView
        android:id="@+id/back_btn"
        android:layout_width="@dimen/_24sdp"
        android:layout_height="@dimen/_16sdp"
        android:src="@drawable/back_btn"
        app:layout_constraintBottom_toBottomOf="@+id/appbar_txt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/appbar_txt" />

    <TextView
        android:id="@+id/appbar_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/category_birds"
        android:textColor="@color/black"
        android:textSize="@dimen/_17sdp"
        android:fontFamily="@font/sfpro_bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />



    <FrameLayout
        android:id="@+id/ads_container"
        android:layout_margin="@dimen/_10sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/appbar_txt"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/view_favouriteUrl_RV"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintTop_toBottomOf="@id/ads_container"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteX="13dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
