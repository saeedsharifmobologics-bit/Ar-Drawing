<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/appBackground"

    tools:context=".onBoardingScreen.HowDrawWithCameraFragment">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_200sdp"
        android:scaleType="fitXY"
        android:src="@drawable/draw_with_camera_png"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="0dp" />

    <TextView
        android:id="@+id/draw_with_camera_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/_15sdp"
        android:text="@string/draw_with_camera"
        android:fontFamily="@font/sfpro_bold"
        android:textColor="@color/black"
        app:layout_constraintTop_toBottomOf="@+id/imageView"

        />

    <TextView
        android:id="@+id/textDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/_12sdp"
        android:fontFamily="@font/sfpro_regular"

        android:text="@string/draw_with_camera_description"
        android:textColor="@color/onboardingTextColor"
        app:layout_constraintTop_toBottomOf="@+id/draw_with_camera_title" />


</androidx.constraintlayout.widget.ConstraintLayout>