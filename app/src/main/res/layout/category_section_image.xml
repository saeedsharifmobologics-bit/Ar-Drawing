<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/_5sdp">

    <!-- Image 1 -->
    <ImageView
        android:id="@+id/section_image_1"
        android:layout_width="0dp"
        android:layout_height="@dimen/_100sdp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/custom_image_view_shape"
        android:padding="@dimen/_5sdp"
        android:scaleType="fitXY"
        android:src="@drawable/character_08"
        app:layout_constraintEnd_toStartOf="@+id/section_image_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <!-- Image 2 -->
    <ImageView
        android:id="@+id/section_image_2"
        android:layout_width="0dp"
        android:layout_height="@dimen/_100sdp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/custom_image_view_shape"
        android:padding="@dimen/_5sdp"
        android:scaleType="fitXY"
        android:src="@drawable/character_08"
        app:layout_constraintEnd_toStartOf="@+id/section_image_3"
        app:layout_constraintStart_toEndOf="@id/section_image_1"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <!-- Image 3 -->
    <ImageView
        android:id="@+id/section_image_3"
        android:layout_width="0dp"
        android:layout_height="@dimen/_100sdp"
        android:background="@drawable/custom_image_view_shape"
        android:padding="@dimen/_5sdp"
        android:scaleType="fitXY"
        android:src="@drawable/character_08"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/section_image_2"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

</androidx.constraintlayout.widget.ConstraintLayout>
